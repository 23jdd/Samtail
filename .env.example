# Samtail 配置文件示例
# 复制为 .env 后使用: ./samtail -f .env

# 监控目录（默认: logs）
SAMTAIL_DIR=logs

# SamKv 数据库端点（默认: http://127.0.0.1:9999/logs/batch）
SAMTAIL_DB_URL=http://127.0.0.1:9999/logs/batch

# 本地备份目录（默认: ./output）
SAMTAIL_OUTPUT=./output

# 批量大小，达到后立即刷新（默认: 1000）
SAMTAIL_BATCH_SIZE=1000

# 定时刷新间隔（秒）（默认: 2）
SAMTAIL_FLUSH_SECS=2
